# deps
node_modules/
.pnpm-store/

# build output
dist/
build/
.turbo/
*.tsbuildinfo
coverage/

# env / secrets (owner key must never live here)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# foundry
packages/contracts/out/
packages/contracts/cache/
packages/contracts/broadcast/
# dry-run deployments (only the real Fuji file is committed)
packages/contracts/deployments/*.json
!packages/contracts/deployments/fuji.json
# raw Slither report (local paths); proof/tests.json keeps the summary
packages/contracts/slither.json

# local data / test artifacts
infra/data/
playwright-report/
test-results/

# claude local settings
.claude/settings.local.json

# start.sh dev server logs
.dev-logs/

# stray root-level env copies (e.g. received from a teammate): never commit
/*.env
/*.env.*

# Crossnote (Markdown preview extension): per-editor settings
.crossnote/
