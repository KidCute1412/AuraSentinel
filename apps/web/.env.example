# Public values only. Never put the owner key or session key here.
VITE_API_URL=/api
VITE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VITE_WALLETCONNECT_PROJECT_ID=

# "live" (default): real API + SSE, real wallet sign-in (SIWE) against the server. Needs the backend running
# (start.bat does that). "mock": in-browser simulation, no backend, fake wallet. Tests always run as "mock".
VITE_DATA_SOURCE=live
# Live mode, optional: the public demo Safe for /demo (= SAFE_ADDRESS in apps/server/.env). Empty = ask the
# server which registered vault is the demo one (GET /vaults, isDemo).
VITE_DEMO_SAFE=
