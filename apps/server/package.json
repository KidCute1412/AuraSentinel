{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "nest start --watch --entryFile main.api",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "build": "nest build",
    "start:api": "node dist/main.api.js",
    "start:worker": "node dist/main.worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@bull-board/api": "^6.9.0",
    "@bull-board/express": "^6.9.0",
    "@bull-board/nestjs": "^6.9.0",
    "@google/genai": "^1.0.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "bullmq": "^5.53.0",
    "drizzle-orm": "^0.44.0",
    "ioredis": "^5.6.0",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "^4.3.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "postgres": "^3.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viem": "^2.31.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.28.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "pino-pretty": "^13.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  }
}
