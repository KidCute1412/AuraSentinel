NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgres://agentshield:agentshield@localhost:55432/agentshield
REDIS_URL=redis://localhost:56379

# Comma separated; first is primary, rest are fallbacks
FUJI_RPC_URLS=https://api.avax-test.network/ext/bc/C/rpc
ANVIL_RPC_URL=http://127.0.0.1:8545

# Agent SESSION key only. Never the owner key.
AGENT_PRIVATE_KEY=

# From packages/contracts/deployments/fuji.json (docs/runbook/deploy-fuji.md):
# SAFE_ADDRESS=publicSafe, POLICY_MODULE_ADDRESS=publicModule, TOKEN_A_ADDRESS=usdc, TOKEN_B_ADDRESS=wavax
SAFE_ADDRESS=
POLICY_MODULE_ADDRESS=
TOKEN_A_ADDRESS=
TOKEN_B_ADDRESS=

# Indexer: factory from deployments/fuji.json, start block = its deploy block (empty = from the head)
FACTORY_ADDRESS=
INDEXER_START_BLOCK=
INDEXER_POLL_MS=1000
# Blocks per eth_getLogs: public Fuji RPC allows 100
INDEXER_MAX_SPAN=100

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=10
EXPLAINER_TIMEOUT_MS=2000
REBALANCE_INTERVAL_MS=15000

# Abuse protection on POST /vaults/{safe}/jobs and /attacks (0 disables a limit)
WRITE_LIMIT_PER_IP=10
WRITE_IP_WINDOW_MS=60000
WRITE_COOLDOWN_MS=2000
DEMO_WRITE_COOLDOWN_MS=5000
# Refuse new jobs below this agent balance (wei); 0.02 AVAX
AGENT_MIN_GAS_WEI=20000000000000000
# Only when the web is served from another origin (dev uses the Vite proxy: not needed)
CORS_ORIGINS=

# Sign-in (SIWE). Dev: empty SESSION_SECRET = random per start (sessions end on restart)
SESSION_SECRET=
# The web runs on Vite (5173) and proxies /api here, so the SIWE domain is the Vite host
SIWE_DOMAINS=localhost:5173
ADMIN_ADDRESSES=
