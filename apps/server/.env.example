SAFE_ADDRESS=
POLICY_MODULE_ADDRESS=
TOKEN_A_ADDRESS=
TOKEN_B_ADDRESS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=10
EXPLAINER_TIMEOUT_MS=2000
REBALANCE_INTERVAL_MS=15000
