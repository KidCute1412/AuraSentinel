# The only env file for local dev (start.bat copies it to apps/server/.env once). Never commit the copy.
# Everything public has a default in code: Fuji contract addresses and indexer start block (packages/shared
# deployments.ts), public Fuji RPCs, the local Postgres/Redis ports, limits (src/core/config/env.schema.ts).

# Agent SESSION key: the one key the policy module accepts (agentSigner). Never the owner key.
# Only one machine at a time may run the worker against Fuji with it (one nonce chain, P4).
AGENT_PRIVATE_KEY=

# Optional: LLM explanations (Gemini). Empty = deterministic template text.
GEMINI_API_KEY=

# Optional: any OpenAI-compatible LLM endpoint (self-hosted vLLM, Ollama...). When LLM_BASE_URL is set it is used
# instead of Gemini and LLM_MODEL is required. This machine must reach it, e.g. through an SSH tunnel:
#   ssh -N -L 18449:127.0.0.1:8449 <gpu-host>   ->   LLM_BASE_URL=http://127.0.0.1:18449/v1
LLM_BASE_URL=
LLM_KEY=
LLM_MODEL=

# Red-team Hijacked Agent: the LLM brain gets this long before the keyword planner takes over (default 8000), and one
# Auto red-team run (5 LLM-written attacks) is allowed per vault per AUTO_REDTEAM_COOLDOWN_MS (default 60000).
# PLANNER_TIMEOUT_MS=8000
# AUTO_REDTEAM_COOLDOWN_MS=60000

# Optional: your wallet(s), comma separated, to open the admin drawer (Demo mode) and Bull Board.
ADMIN_ADDRESSES=

# Optional overrides, all of them have defaults. Uncomment only what you need, e.g.:
# FUJI_RPC_URLS=https://your-dedicated-rpc,https://avalanche-fuji-c-chain-rpc.publicnode.com
# REBALANCE_INTERVAL_MS=15000
# DEMO_WRITE_COOLDOWN_MS=5000
# LOG_LEVEL=debug
