# Copy to infra/.env (gitignored). Used by docker compose only.
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=agentshield
POSTGRES_DB=agentshield

# Fuji RPC the Anvil fork starts from (use your dedicated RPC for reliability)
FORK_URL=https://api.avax-test.network/ext/bc/C/rpc

# Host ports (5432/6379 are often taken by other local projects)
POSTGRES_PORT=55432
REDIS_PORT=56379
ANVIL_PORT=8545
