# Copy to infra/.env.prod (gitignored) for docker-compose.prod.yml.
# NEVER put the owner/deployer key here. The only key is the agent SESSION key, read by the worker.

# Postgres (internal to the compose network; still pick a real password)
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=
POSTGRES_DB=agentshield

# Fuji RPC: comma separated, dedicated RPC first, public fallback last
FUJI_RPC_URLS=https://api.avax-test.network/ext/bc/C/rpc
# The simulation fork starts from this one (usually the first of FUJI_RPC_URLS)
FORK_URL=https://api.avax-test.network/ext/bc/C/rpc

# Agent session key (L4 step 0). Fund it with ~0.5 AVAX Fuji for gas.
AGENT_PRIVATE_KEY=

# From packages/contracts/deployments/fuji.json
SAFE_ADDRESS=
POLICY_MODULE_ADDRESS=
TOKEN_A_ADDRESS=
TOKEN_B_ADDRESS=
FACTORY_ADDRESS=
# Block of the factory deployment (indexer backfill starts here)
INDEXER_START_BLOCK=
INDEXER_MAX_SPAN=100

# Optional: LLM explanations (template fallback without it)
GEMINI_API_KEY=
GEMINI_RPM=10

# Web (public values, baked into the bundle)
VITE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VITE_WALLETCONNECT_PROJECT_ID=
WEB_PORT=8080

LOG_LEVEL=info
REBALANCE_INTERVAL_MS=15000
