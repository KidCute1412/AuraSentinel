# The only env file for production (docker-compose.prod.yml). Create it with `pnpm env:prod`, which fills the three
# secrets below with fresh random values; then add the agent key. Gitignored: never commit the real file.
# Public values (Fuji addresses, RPCs, limits) have defaults in code. NEVER put the owner/deployer key here.

# --- Secrets ---
# Agent SESSION key, read by the worker only. Fund its address with ~0.5 AVAX Fuji for gas.
AGENT_PRIVATE_KEY=
# 32+ random chars each (pnpm env:prod generates them). Changing SESSION_SECRET signs everyone out.
SESSION_SECRET=
POSTGRES_PASSWORD=
# Web on Vercel (apps/web/api/proxy.ts): put the same value in Vercel's WEB_PROXY_SECRET.
WEB_PROXY_SECRET=

# --- This deployment ---
# Wallets allowed in the admin drawer (Demo mode) and Bull Board, comma separated. Set it: Demo mode needs it.
ADMIN_ADDRESSES=
# host[:port] the browser shows, e.g. your-app.vercel.app. Empty = the request Host (fine for nginx on localhost:8080).
SIWE_DOMAINS=

# --- Optional ---
# LLM explanations (template text without it)
GEMINI_API_KEY=
# Telegram alerts (--profile monitoring): bot from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WalletConnect Cloud project id: QR / mobile wallets on the nginx-served web
VITE_WALLETCONNECT_PROJECT_ID=

# Any other server setting can be overridden here too (FUJI_RPC_URLS, DEMO_WRITE_COOLDOWN_MS, WEB_PORT, ...):
# see infra/docker-compose.prod.yml for the list and the defaults.

# Optional: an OpenAI-compatible LLM endpoint for the explainer and the red-team Hijacked Agent brain. When set it
# replaces Gemini (GEMINI_API_KEY). LLM_BASE_URL ends at /v1 (the server adds /chat/completions); LLM_KEY is the token
# after "Bearer". Empty: Gemini if GEMINI_API_KEY is set, else templates and the keyword planner.
LLM_BASE_URL=
LLM_KEY=
LLM_MODEL=
